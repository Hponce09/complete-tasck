# URL del proyecto Supabase (Project Settings → API)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# Solo servidor local. Usa la Secret key (sb_secret_...) del panel.
# Nunca añadir el prefijo NEXT_PUBLIC_ a esta variable.
SUPABASE_SECRET_KEY=pega-aqui-tu-secret-key

# La escritura y lectura del destino requieren la clave secreta solo de servidor.
